# Database configuration
DATABASE_URL=mysql+pymysql://CHANGE_ME_USERNAME:CHANGE_ME_PASSWORD@127.0.0.1:3306/wastewise?charset=utf8mb4
MYSQL_ADMIN_URL=mysql+pymysql://CHANGE_ME_ADMIN_USER:CHANGE_ME_ADMIN_PASSWORD@127.0.0.1:3306/mysql?charset=utf8mb4
MYSQL_DATABASE=wastewise

# Application secrets (REQUIRED for production, optional in development)
# Generate these with:
#   python -c "from app.core.security import generate_api_key, generate_secret_key; print(generate_api_key()); print(generate_secret_key())"
# Replace the placeholders before running in production (DEBUG=false).
API_KEY=CHANGE_ME_GENERATE_A_UNIQUE_API_KEY
SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_SECRET_KEY

# Application settings
PROJECT_NAME=WasteWise AI
VERSION=1.0.0
DEBUG=true

# Single-user browser login (the password must be a PBKDF2-SHA256 hash).
AUTH_EMAIL=your-email@example.com
AUTH_PASSWORD_HASH=
